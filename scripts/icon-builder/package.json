{
  "name": "@icones/icon-builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Icon maintenance scripts and generation tooling.",
  "scripts": {
    "build": "bun run generate:names",
    "generate:names": "bun src/cli/generate-names.ts",
    "check:names": "bun src/cli/generate-names.ts --check",
    "generate:types": "bun run generate:names",
    "check:types": "bun run check:names",
    "download:icons": "bun src/cli/download-official.ts",
    "download:api": "bun src/cli/download-api.ts",
    "generate:symbols": "bun src/cli/generate-symbols.ts",
    "benchmark:packages": "bun src/benchmark/packages.ts",
    "build:static": "bun src/build/static.ts",
    "build:icons": "bun src/cli/build-icons.ts",
    "deploy:icons": "bun src/cli/deploy-icons.ts",
    "typecheck": "bun run check:names && tsc --noEmit && bun run typecheck:tests",
    "test": "bun test ./tests",
    "typecheck:tests": "tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@icones/vite": "workspace:*",
    "@iconify/types": "2.0.0",
    "@iconify/utils": "3.1.7",
    "@icones/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2"
  }
}