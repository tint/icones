{
  "name": "@icones/package-builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Private npm release staging and publication checks.",
  "scripts": {
    "build": "bun src/cli.ts",
    "pack": "bun src/cli.ts --pack",
    "publish": "bun src/cli.ts --pack --publish",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2"
  }
}