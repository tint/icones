{
  "name": "@icones/mcp-server",
  "version": "0.0.2",
  "license": "MIT",
  "description": "Read-only stdio MCP tools for local icons and bundled framework guides.",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://icones.go-slim.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tint/icones.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/tint/icones/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "bin": {
    "icones-mcp-server": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run generate:docs && tsdown",
    "generate:docs": "bun scripts/generate-docs.ts",
    "check:docs": "bun scripts/generate-docs.ts --check",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json && bun run typecheck:tests",
    "test": "bun test ./tests",
    "typecheck:tests": "tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@icones/core": "workspace:^",
    "@icones/icons": "workspace:^",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsdown": "^0.22.5",
    "typescript": "~6.0.2",
    "@types/bun": "^1.3.5",
    "@modelcontextprotocol/client": "^2.0.0",
    "vite": "^8.2.2"
  }
}