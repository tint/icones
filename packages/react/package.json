    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "@vitejs/plugin-react": "^6.1.0",
    "@types/bun": "^1.3.5",
    "@types/node": "^24.13.3",
    "jsdom": "^30.0.1",
    "@types/jsdom": "^30.0.0"
  }
}