{
  "name": "@icones/gallery",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "build": "react-router typegen && tsc -b && react-router build",
    "typecheck": "react-router typegen && tsc -b && bun run typecheck:tests",
    "preview": "vite preview --host 127.0.0.1",
    "test": "bun test ./tests",
    "typecheck:tests": "tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@icones/core": "workspace:*",
    "@icones/react": "workspace:*",
    "@react-router/node": "8.3.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "tailwind-merge": "^3.6.0",
    "isbot": "^5"
  },
  "devDependencies": {
    "@icones/vite": "workspace:*",
    "@react-router/dev": "8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "@types/bun": "^1.3.5",
    "@types/jsdom": "^30.0.0",
    "jsdom": "^30.0.1",
    "@icones/vanilla": "workspace:*",
    "@icones/icons": "workspace:*"
  }
}